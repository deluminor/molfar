# Shell scripts are also embedded in the desktop app and sent to Unix hosts.
*.sh text eol=lf

# Signature verification requires identical package bytes on every platform.
crates/molfar-core/src/app_update/fixtures/package.txt text eol=lf

# The embedded prompt fixture must match the builder's LF output exactly.
crates/molfar-core/src/task_board/stage/contracts/fixtures/*.md text eol=lf

# Golden Markdown is compared to LF produced by the exporters.
crates/molfar-core/src/atlassian/adf/fixtures/*.md text eol=lf
crates/molfar-core/src/confluence/document/fixtures/*.md text eol=lf
