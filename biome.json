{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "src/**",
      "host/**",
      "scripts/**",
      "*.ts",
      "!src-tauri",
      "!vendor",
      "!dist",
      "!build"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "suspicious": {
        "noImportCycles": "error",
        "noConsole": {
          "level": "error",
          "options": {
            "allow": ["error", "warn"]
          }
        }
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case"],
            "requireAscii": true
          }
        }
      },
      "correctness": {
        "useExhaustiveDependencies": {
          "level": "on",
          "options": {
            "hooks": [
              {
                "name": "useWorkspaceActions",
                "stableResult": [
                  "setProjectCwd",
                  "setRecents",
                  "setSessions",
                  "setTabs",
                  "setActiveTabId",
                  "setTabVisitNav"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "overrides": [
    {
      "includes": ["scripts/**"],
      "linter": {
        "rules": {
          "suspicious": {
            "noConsole": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["PascalCase", "kebab-case"],
                "requireAscii": true
              }
            }
          }
        }
      }
    }
  ]
}
